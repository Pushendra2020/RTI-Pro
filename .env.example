# Saathi RTI Citizen Assistant
# Copy this file to .env.local and fill only the integrations you are enabling.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Reasoning model adapter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional model provider override, if Gemma is served through another gateway
MODEL_PROVIDER=gemini
MODEL_API_BASE_URL=
MODEL_API_KEY=

# Sarvam speech layer
SARVAM_API_KEY=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=

# Pinecone official-document retrieval
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_HOST=
PINECONE_NAMESPACE=rti-official
PINECONE_DIMENSION=768
PINECONE_ENVIRONMENT=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768

# Supabase structured authority and application data
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=

# Optional email notification layer
BRAVO_API_KEY=
BRAVO_FROM_EMAIL=
BRAVO_FROM_NAME=Saathi RTI Assistant

# Workflow adapter, when LangGraph is hosted separately
LANGGRAPH_API_URL=
LANGGRAPH_API_KEY=

# Demo configuration
NEXT_PUBLIC_DEFAULT_STATE=Maharashtra
NEXT_PUBLIC_DEFAULT_DISTRICT=Nashik
NEXT_PUBLIC_RTI_PORTAL_URL=https://rtionline.maharashtra.gov.in/
