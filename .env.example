# Saathi RTI Citizen Assistant
# Copy this file to .env.local and fill only the integrations you are enabling.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Reasoning model adapter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional model provider override, if Gemma is served through another gateway
MODEL_PROVIDER=gemini
MODEL_API_BASE_URL=
MODEL_API_KEY=

# Sarvam speech layer (SARVAM_API_KEY is the api-subscription-key from Sarvam)
SARVAM_API_KEY=
# Optional alias if you use the SDK's full parameter name
SARVAM_API_SUBSCRIPTION_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=

# Reserved external-vector fallback (inactive for the current Pinecone integrated index)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSION=1024

# Active Pinecone managed inference retrieval
PINECONE_API_KEY=
PINECONE_INDEX=rti-pro
PINECONE_HOST=https://rti-pro-jpaw375.svc.aped-4627-b74a.pinecone.io
PINECONE_NAMESPACE=default
PINECONE_DIMENSION=1024
PINECONE_EMBEDDING_MODEL=multilingual-e5-large
PINECONE_EMBEDDING_FIELD_MAP=text
PINECONE_ENVIRONMENT=
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# Supabase structured authority and application data
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=


# Optional email notification layer
BRAVO_API_KEY=
BRAVO_FROM_EMAIL=
BRAVO_FROM_NAME=Saathi RTI Assistant

# Workflow adapter, when LangGraph is hosted separately
LANGGRAPH_API_URL=
LANGGRAPH_API_KEY=

# Demo configuration
NEXT_PUBLIC_RTI_PORTAL_URL=https://rtionline.maharashtra.gov.in/
